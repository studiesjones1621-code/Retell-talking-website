# Copy to .env.local for local work. .env.local is git-ignored.
# On Vercel, these same names go under Settings → Environment Variables.

# ---------------------------------------------------------------------------
# FILL THESE IN
# ---------------------------------------------------------------------------

# Retell private API key — retellai.com → Dashboard → API Keys
RETELL_API_KEY=

# Cal.com API key — app.cal.com → Settings → Developer → API Keys
# Leave blank for lead-capture mode (the agent takes a name, phone and
# preferred time instead of booking on the calendar).
CAL_API_KEY=

# Any word you invent, e.g. "hvac2026". Unlocks the one-button /setup page.
# Leave blank and /setup returns 404, which is the right setting once your
# agent is created and working.
SETUP_SECRET=

# ---------------------------------------------------------------------------
# LEAVE THESE BLANK
#
# Filled in for you: `npm run provision:retell` writes them to .env.local, and
# the /setup page makes them unnecessary entirely — the site looks the agent up
# on your Retell account when they are empty. Setting them by hand is optional
# and only saves one lookup.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_RETELL_AGENT_ID=
RETELL_LLM_ID=

# ---------------------------------------------------------------------------
# OPTIONAL
# ---------------------------------------------------------------------------

# Retell public key — only needed if you switch to Retell's drop-in widget.
NEXT_PUBLIC_RETELL_PUBLIC_KEY=

# Google Gemini key — only for `npm run generate:images`.
GEMINI_API_KEY=
