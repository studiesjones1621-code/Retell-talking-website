# Copy to .env.local and fill in. .env.local is git-ignored.

# Retell private API key — retellai.com → Dashboard → API Keys
RETELL_API_KEY=

# Retell public key — retellai.com → Dashboard → Public Keys
# Only required for the official drop-in widget (see README).
NEXT_PUBLIC_RETELL_PUBLIC_KEY=

# Cal.com API key — app.cal.com → Settings → Developer → API Keys
# Leave blank or set to SKIP for lead-capture mode (no real bookings).
CAL_API_KEY=

# Google Gemini key — aistudio.google.com. Only for `npm run generate:images`.
GEMINI_API_KEY=

# Written automatically by `npm run provision:retell`.
NEXT_PUBLIC_RETELL_AGENT_ID=
RETELL_LLM_ID=
